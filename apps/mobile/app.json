{
  "expo": {
    "name": "Scribble",
    "slug": "scribble",
    "scheme": "scribble",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://scribble-zeta-henna.vercel.app"
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Scribble listens when you hold the speak button so it can capture tasks, meetings, and reminders."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ]
    }
  }
}
